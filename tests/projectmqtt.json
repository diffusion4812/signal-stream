        { "name": "thrust", "type": "float", "unit": "%" },
        { "name": "setpoint", "type": "float", "unit": "m" },
        { "name": "kp", "type": "float", "unit": "%" },
        { "name": "ki", "type": "float", "unit": "%" },
        { "name": "kd", "type": "float", "unit": "%" }
      ]
    }
  ]
}